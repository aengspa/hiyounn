# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files - NEVER commit real secrets. Only .env.example is committed.
.env
.env.*
!.env.example
.env*.local
.env.local
.env.development.local
.env.production.local

# typescript
*.tsbuildinfo
next-env.d.ts

# temp logs
dev2.log

# local dev artifacts (logs, tools, e2e output)
/.local/

# build-time bundled tool binaries (scripts/fetch-gitleaks.mjs)
/vendor-bin/

# sample apps are run locally for testing
/samples/*/node_modules/

# local run/build logs
*.log
