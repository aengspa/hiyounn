# ─────────────────────────────────────────────────────────────
# Vibe Coding Security Agent — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Only this .env.example belongs in git.
# ─────────────────────────────────────────────────────────────

# --- Session signing secret (server-only) ---
# REQUIRED in production. Without a stable AUTH_SECRET, session cookies signed
# by one serverless function are rejected by the next (users get logged out at
# random). Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# --- Supabase (public / client-safe keys) ---
# Safe to expose to the browser. Do NOT put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server-only secret) ---
# Server-side only. Never prefix with NEXT_PUBLIC_. Bypasses RLS — keep secret.
# REQUIRED when DATA_STORE=supabase.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- AI 코드 분석 / 수정안 생성 (서버 전용) ---
# 실제 AI 스캔을 켜려면 아래 값을 채우세요. 미설정이면 데모 스캐너만 동작합니다.
# LLM_PROVIDER: openai | anthropic | gemini | none
LLM_PROVIDER=none
LLM_API_KEY=
# (선택) 모델명. 미지정 시 제공자별 기본값 사용.
#   openai   기본 gpt-4o-mini
#   anthropic 기본 claude-3-5-sonnet-latest
#   gemini   기본 gemini-1.5-flash
LLM_MODEL=

# --- Data store mode ---
# "memory" (default) keeps data in process memory — fine for local dev, but on
#   Vercel each serverless invocation may run in a different process, so data
#   written by one request is NOT visible to another (scans "disappear").
# "supabase" persists to Postgres so state is shared across all invocations.
#   Use this in ANY deployed environment. Requires NEXT_PUBLIC_SUPABASE_URL and
#   SUPABASE_SERVICE_ROLE_KEY, and the tables in supabase/schema.sql.
DATA_STORE=memory
